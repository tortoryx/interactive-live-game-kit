# Optional: keep empty for offline rules-only gameplay. No accounts required.
AI_MODEL=
AI_CHAT_URL=
AI_API_KEY=
# USD per million tokens, from your provider; required to enable AI.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Optional DeepSeek host commentary (API billing). Enable in Settings after start.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Replace these estimates with your current provider rates (USD / million tokens).
DEEPSEEK_INPUT_USD_PER_MILLION=0.3
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.2
# Local ports, if the defaults are occupied.
STAGE_PORT=4390
CONTROL_PORT=4391
BROKER_PORT=4392
